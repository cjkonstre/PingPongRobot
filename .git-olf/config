[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = https://github.com/cjkonstre/PingPongRobot.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[submodule "external/ball_tracking"]
	url = https://gitlab.tuebingen.mpg.de/sgomez/ball_tracking.git
	active = true
